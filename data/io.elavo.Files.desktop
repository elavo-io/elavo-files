[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse and organize your files
Keywords=folder;manager;finder;explore;disk;filesystem;network;
Exec=elavo-files %U
Icon=system-file-manager
Terminal=false
StartupNotify=true
DBusActivatable=true
Categories=GTK;System;FileTools;FileManager;Core;
MimeType=inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=elavo-files
